# --- Credentials -------------------------------------------------------------
# Superuser. Created by the image entrypoint on a fresh data directory; on an
# existing one, init.sh resets it to this value.
POSTGRES_PASSWORD=ChangeThisToASecureSuperuserPassword

# Application database and its owner. init.sh creates the database with this
# role as OWNER, which is what grants it the public schema: PostgreSQL 15
# revoked CREATE on public from PUBLIC, and the public schema is owned by
# pg_database_owner.
PG_APP_DB=app_db
PG_APP_USER=app_user
PG_APP_PASSWORD=ChangeThisToASecureAppPassword

# --- Network -----------------------------------------------------------------
# Host IPv4 address. Keep loopback for host-local access; set a host interface
# address for remote access. Firewall rules must restrict the published port.
PG_BIND_ADDRESS=127.0.0.1
PG_PORT=5432

# Required: one backend source IPv4/IPv6 CIDR as PostgreSQL sees it.
# Example: 192.0.2.10/32. Use the public egress IP for a backend behind NAT,
# or the appropriate private/Docker subnet. Unrestricted /0 is rejected.
PG_APP_ALLOWED_CIDR=

# Required absolute host directory containing fullchain.pem and privkey.pem.
# Files are provisioned and renewed outside this repository.
PG_TLS_DIR=/opt/databases/tls/db.example.com

# --- Resources ---------------------------------------------------------------
# The cgroup limit on the container. PostgreSQL cannot see it, so the four
# memory settings in postgresql.conf are derived from this value by hand:
#
#   shared_buffers        = 25% of PG_MEM_LIMIT
#   effective_cache_size  = 75% of PG_MEM_LIMIT
#   work_mem              = 32MB at 8g, scaled with max_connections
#   maintenance_work_mem  = 512MB at 8g
#
# Changing PG_MEM_LIMIT without changing postgresql.conf either wastes the
# memory or gets the container OOM-killed.
PG_MEM_LIMIT=8g

# --- Backups -----------------------------------------------------------------
# pgBackRest retention, counted in backups rather than days. Two full backups
# taken weekly means the archive covers roughly two weeks of point-in-time
# recovery. WAL is expired together with the full backup it belongs to.
PGBACKREST_RETENTION_FULL=2
PGBACKREST_RETENTION_DIFF=6

# Backstop against a stuck archive filling the filesystem. Once this much WAL is
# waiting, pgBackRest reports success and discards it, bounding pg_wal at the
# cost of a gap in the recovery chain. Size it to space that can be spent without
# endangering anything else sharing the filesystem. archive-guard.sh should catch
# a stuck archive long before this is reached.
PGBACKREST_ARCHIVE_QUEUE_MAX=64GiB

# --- Guard thresholds --------------------------------------------------------
# archive-guard.sh exits nonzero on CRITICAL, so a stuck archive appears in
# "systemctl --failed". Backlog is counted in 16MB WAL segments.
PG_GUARD_READY_WARN=20
PG_GUARD_READY_CRIT=200
PG_GUARD_DISK_WARN_PCT=85
PG_GUARD_DISK_CRIT_PCT=92
# Daily differential timer plus slack. Catches a timer that stopped firing.
PG_GUARD_BACKUP_MAX_AGE_HOURS=36
